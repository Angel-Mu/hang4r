{
  "name": "hang4r-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "hang4r companion app — drive your desktop agent sessions from a phone",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
